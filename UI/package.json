{
  "name": "planboard-ui",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "webpack --config webpack.config.cjs --mode production",
    "deploy": "webpack --config webpack.config.cjs --mode production --env deploy=true",
    "dev": "webpack --config webpack.config.cjs --mode development --env deploy=true --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test ../Tests/*.test.mjs"
  },
  "dependencies": {
    "classnames": "2.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.0.26",
    "@types/react-dom": "18.0.9",
    "css-loader": "6.7.2",
    "mini-css-extract-plugin": "2.7.0",
    "sass": "1.78.0",
    "sass-loader": "13.2.0",
    "style-loader": "3.3.4",
    "terser-webpack-plugin": "5.4.0",
    "ts-loader": "9.5.1",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "5.7.3",
    "webpack": "5.97.1",
    "webpack-cli": "5.1.4"
  }
}
